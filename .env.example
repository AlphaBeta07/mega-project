# =============================================================================
# StudySnap AI — Master Environment Configuration Template
# Copy this file to .env in each corresponding subdirectory or use for deployment
# =============================================================================

# ── Frontend (frontend/.env) ─────────────────────────────────────────────────
VITE_API_GATEWAY_URL=http://localhost:5000
VITE_AI_BACKEND_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# ── Main Application Gateway (main_backend/.env) ─────────────────────────────
PORT=5000
NODE_ENV=development
FASTAPI_BACKEND_URL=http://localhost:8000
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ── AI Engine Backend (backend/.env) ─────────────────────────────────────────
PORT=8000
CHROMA_PERSIST_DIR=./chroma_data
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=llama-3.2-1b-instruct
COMFYUI_URL=http://localhost:8188

# Supabase PostgreSQL & Auth Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
SUPABASE_SECRET_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
SUPABASE_STORAGE_BUCKET=studysnap-assets

# Optional Gemini Fallback Key
GEMINI_API_KEY=your-gemini-api-key-here
