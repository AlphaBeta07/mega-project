# StudySnap AI Backend Environment Configuration (Supabase + ChromaDB)

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Supabase PostgreSQL & Auth Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
SUPABASE_SECRET_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
SUPABASE_STORAGE_BUCKET=studysnap-assets

# Vector Database (Local ChromaDB)
CHROMA_PERSIST_DIR=./chroma_data

# LM Studio Local AI Model Base URL
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=llama-3.2-1b-instruct

# Optional Fallback Cloud LLM
GEMINI_API_KEY=your_gemini_api_key_here
