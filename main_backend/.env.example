# ===================================================
# StudySnap AI — Main Backend Environment Configuration
# ===================================================

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Points to existing studysnap_db)
MONGO_URI=mongodb://localhost:27017/studysnap_db

# JWT Authentication Secrets
JWT_SECRET=studysnap_jwt_super_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Existing Python FastAPI Chatbot Backend URL
CHATBOT_BACKEND_URL=http://localhost:8000

# Allowed Frontend Origins (CORS)
FRONTEND_URL=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
