# StudySnap AI Backend Environment Configuration

# Gemini API Key (for LLM reasoning & vision/audio processing)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Database Configuration
MONGODB_URL=mongodb://localhost:27017
DB_NAME=studysnap_db

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# LM Studio Local AI Model Base URL
LM_STUDIO_URL=http://localhost:1234/v1
MODEL_NAME=my_custom_200m_model_gguf/AnishLandage/SnapStudyAI

# JWT Secret Key (for team authentication service)
JWT_SECRET=studysnap_ai_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
